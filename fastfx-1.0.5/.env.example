# FastFX — local environment template
#
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored so secrets never leave your machine.

# Sentry auth token — required for source map upload during production builds.
# Without this, builds still succeed but source maps won't be uploaded to Sentry,
# which means stack traces in the Sentry dashboard will show minified code
# instead of readable file/line references.
#
# Get the token from: ~/Plugins/_shared/sentry-secrets.md
# Or create a new one at: https://tiny-tapes.sentry.io/settings/auth-tokens/
# Required scopes: org:ci
SENTRY_AUTH_TOKEN=sntrys_your_token_here
